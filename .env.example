NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DB_FILE=data/promptgate.sqlite
# PROMPTGATE_SECRET 必须使用 openssl rand -hex 32 生成
PROMPTGATE_SECRET=change-me
LOG_LEVEL=info
# pm2 进程内存超过该值会被重启（如 2G、4096M）
PM2_MAX_MEMORY=2G
# DB_BACKUP_PASSWORD 必须使用 openssl rand -hex 32 生成，用于下载数据库备份验证密钥（不设置则禁用下载功能）
DB_BACKUP_PASSWORD=


{
  "name": "yutrix",
  "version": "1.0.0",
  "private": true,
  "description": "Yutrix (驭算) — LLM gateway for cost control, routing, and audit (Community)",
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "pm2 start ecosystem.config.cjs",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "pnpm -r test"
  },
  "overrides": {
    "sharp": "^0.34.0"
  },
  "resolutions": {
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@babel/register": "^8.0.6",
    "jest-mock": "^30.5.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}

{
  "name": "@promptgate/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node -r ./preload.js dist/index.js",
    "test": "vitest run",
    "chat-logs:clear": "tsx src/scripts/cleanup-logs.ts",
    "db:push": "drizzle-kit push:sqlite",
    "db:generate": "drizzle-kit generate:sqlite",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/static": "^9.0.0",
    "@google/genai": "^2.10.0",
    "@libsql/client": "^0.17.3",
    "@node-rs/jieba": "^2.0.1",
    "@promptgate/shared": "workspace:*",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "node-cron": "^4.2.1",
    "pino": "^8.21.0",
    "tiktoken": "^1.0.22",
    "tiktoken-node": "^0.0.7",
    "undici": "^8.3.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.22.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
